class Solution {
public:
    bool isGood(vector<int>& nums) {
      int n=nums.size(),c=0;
      set<int> st;
      for(int i=0;i<n;i++){
        st.insert(nums[i]);
         if(nums[i]==n-1)c++;
         if(nums[i]>n-1)return false;
         
      }
      if(st.size()!=n-1)return false;
      if(c==2)return true;
      return false;
    }
};
