class Solution {
public:
    int countDigitOccurrences(vector<int>& nums, int digit) {
        int c=0;
        for(int i=0;i<nums.size();i++){
            int num=nums[i];
            while(num){
                int rem=num%10;
                num/=10;
                if(rem==digit)c++;
            }
        }
        return c;
    }
};
