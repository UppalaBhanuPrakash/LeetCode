class Solution {
public:
    int countPoints(string s) {
       int n=s.size(),c=0;
       set<string> st;
       for(int i=0;i<n;i+=2){
         string s1 = "";
         s1 += s[i];
         s1 += s[i+1];
         st.insert(s1);
       } 
       for(char i='0';i<='9';i++){
        string b = string() + 'B' + i;
        string g = string() + 'G' + i;
        string r = string() + 'R' + i;
        if(st.find(b)!=st.end()&&st.find(g)!=st.end()&&st.find(r)!=st.end()){
            c++;
        }
       }
    return c;
    }
};
