class Solution {
public:
    int maxDifference(string s) {
        int e=100000,o=-1;
       map<char,int> mp;
       for(int i=0;i<s.size();i++){
        mp[s[i]]++;
       }
        for(auto it:mp){
            if(it.second%2){
                o=max(o,it.second);
            }else{
                e=min(e,it.second);
            }
        }
        return o-e;
    }
};
