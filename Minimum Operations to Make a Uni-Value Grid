class Solution {
public:
    int minOperations(vector<vector<int>>& grid, int x) {
        int n=grid.size(),m=grid[0].size();
        vector<int> v(n*m);
        if(m==1&&n==1)return 0;
        int k=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                v[k]=grid[i][j];
                k++;
            }
        }
        k=0;
        sort(v.begin(),v.end());
        int target=v[(v.size()/2)];
        cout<<target;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(abs(target-grid[i][j])%x==0){
                    k+=abs(target-grid[i][j])/x;
                }
                else return -1;
            }
        }
        return k;
    }
};
