class Solution {
public:
    int countHomogenous(string s) {
        int c=0,mod=1000000007;
        long long ans=0;
        for(int i=0;i<s.length();i++){
            if(i<s.length()-1&&s[i]==s[i+1])c++;
            else{
                c++;
                long long d = (1LL * c * (c + 1)) / 2;
                ans+=(d)%mod;
                c=0;
            }
           
        }
        return ans%mod;
    }
};
