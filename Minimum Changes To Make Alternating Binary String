class Solution {
public:
    int minOperations(string s) {
        int c=0,d=0;
        string f="0";
        char curr='1';
        for(int i=0;i<s.length();i++){
           if(s[i]!=f[i])c++;
           f+=curr;
           if(curr=='1')curr='0';
           else curr='1';
        }
        f="1";
        curr='0';
         for(int i=0;i<s.length();i++){
           if(s[i]!=f[i])d++;
           f+=curr;
           if(curr=='1')curr='0';
           else curr='1';
        }
        return min(c,d);
    }
};
