class Solution {
public:
    string countAndSay(int n) {
        vector<string> v;
        string s = "1"; 
        v.push_back(s); 
        for(int i=1;i<n;i++){
        int c=1;
        string s1="";
        if(i==0)s="1";
            for(int j=1;j<s.size();j++){
                if(s[j]==s[j-1]){
                    c++;
                    cout<<"c"<<c;
                }
                else{
                    cout<<"c"<<c;
                s1+=to_string(c);
                s1+=s[j-1];
                c=1;
                }
            }
            s1+=to_string(c);
            s1 += s.back();
            s=s1;
            v.push_back(s);
        }
        return v[n-1];
    }
};
