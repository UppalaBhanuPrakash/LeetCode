class Solution {
public:
    bool isValid(string s) {
        stack<char> st;
        for(int i=0;i<s.length();i++){
            if(st.size()==0&&(s[i]==')'||s[i]=='}'||s[i]==']')){
            return false;
            }
            else{
                if(s[i]=='('||s[i]=='{'||s[i]=='[')
                 st.push(s[i]);
                 else{
                    char c=st.top();
                    if((c=='('&&s[i]==')')||(c=='['&&s[i]==']')||(c=='{'&&s[i]=='}'))
                    st.pop();
                    else
                    return false;
                 }
            }
        }
        if(st.size()==0)return true;
        return false;
    }
};
