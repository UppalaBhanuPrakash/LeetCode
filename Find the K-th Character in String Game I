class Solution {
public:
    char kthCharacter(int k) {
        string s="a";
        string ans=generate(k,s);
        cout<<ans;
        return ans[k-1];
    }
    string generate(int k,string s){
         if(s.size()>=k)return s;
         string s1;
         for(int i=0;i<s.length();i++){
            if(s[i]=='z')s1+='a';
            else s1+=s[i]+1;
         }
         return generate(k,s+s1);
    }
};
