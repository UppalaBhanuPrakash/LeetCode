class Solution {
public:
    int minimumIndex(vector<int>& nums, int itemSize) {
        int mi=INT_MAX,index=-1;
        for(int i=0;i<nums.size();i++){
            if(nums[i]>=itemSize){
                if(mi==nums[i]){
                    continue;
                }
                else{
                    if(mi>nums[i]){mi=nums[i];
                    index=i;}
                }
            }
        }
        return index;
    }
};
