class Solution {
public:
    int smallestBalancedIndex(vector<int>& nums) {
        int mi=INT_MAX,f=0;
        long long prod=1,sum=0;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i];
        }
        int n=nums.size()-1;
        if(sum==1)mi=min(mi,n);
        for(int i=nums.size()-1;i>=0;i--){
            if(i==nums.size()-1){
                sum-=nums[i];
                if(sum==prod){
                    return i;
                }
            }
            else{
                sum-=nums[i];
                if(prod>1e14)return -1;
                prod*=nums[i+1];
                if(sum==prod){                  
                    return i;
                }
            }
        }
      return -1;
    }
};
