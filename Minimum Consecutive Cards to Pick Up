class Solution {
public:
    int minimumCardPickup(vector<int>& nums) {
        map<int,int> mp;int j=0,mi=INT_MAX,f=0;;
        for(int i=0;i<nums.size();i++){
            if(mp.find(nums[i])==mp.end())
            mp[nums[i]]++;
            else{
                mp[nums[i]]++;
                while(mp[nums[i]] == 2){
                mi = min(mi, i-j+1); 
                mp[nums[j]]--;            
                j++; 
                                  
            }
            }
        }
       return mi==INT_MAX?-1:mi;
    }
};
