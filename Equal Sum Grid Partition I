class Solution {
public:
    bool canPartitionGrid(vector<vector<int>>& grid) {
        vector<long long> rowSum,colSum;
        for(int i=0;i<grid.size();i++){
            long long rsum=0;
            for(int j=0;j<grid[i].size();j++){
                rsum+=grid[i][j];
            }
            rowSum.push_back(rsum);
           
        }
        for(int i=0;i<grid[0].size();i++){
            long long csum=0;
            for(int j=0;j<grid.size();j++){
              csum += grid[j][i];
            }
            colSum.push_back(csum);
        }
        long long rtsum=0,ctsum=0;
        for(int i=0;i<rowSum.size();i++){
            rtsum+=rowSum[i];
        }
        for(int i=0;i<colSum.size();i++){
            ctsum += colSum[i];
        }
        long long rightSum=0;
        for(int i=rowSum.size()-1;i>=0;i--){
            rtsum-=rowSum[i];
            rightSum+=rowSum[i];
            if(rtsum==rightSum)return true;
        }
        long long crtSum=0;
         for(int i=colSum.size()-1;i>=0;i--){
            ctsum-=colSum[i];
            crtSum+=colSum[i];
            if(ctsum==crtSum)return true;
        }
        return false;
    }
};
