class Solution {
public:
    int furthestDistanceFromOrigin(string moves) {
        int l=0,r=0,d=0;
        for(int i=0;i<moves.size();i++){
            if(moves[i]=='L')l++;
            else if(moves[i]=='R')r++;
            else d++;
        }
        if(d==moves.size())return d;
        if(r>l)return r+d-l;
        return l+d-r;
    }
};
