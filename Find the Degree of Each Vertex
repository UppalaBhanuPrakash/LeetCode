class Solution {
public:
    vector<int> findDegrees(vector<vector<int>>& matrix) {
        int n=matrix.size();
        vector<int> v;
        for(int i=0;i<n;i++){
            int c=0;
            for(int j=0;j<n;j++){
                if(matrix[j][i]==1)c++;
            }
            v.push_back(c);
        }
        return v;
    }
};
