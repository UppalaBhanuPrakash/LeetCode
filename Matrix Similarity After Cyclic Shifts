class Solution {
public:
    bool areSimilar(vector<vector<int>>& mat, int k) {
     vector<vector<int>> nums(mat.size(), vector<int>(mat[0].size()));
        int m=mat[0].size();
        for(int i=0;i<mat.size();i++){
            for(int j=0;j<mat[0].size();j++){
                nums[i][j]=mat[i][j];
            }
        }
        while(k--){
            for(int i=0;i<mat.size();i++){
                if(i%2==0){
                for(int j=0;j<mat[i].size();j++){
                    if(j!=m-1)
                    {
                     int temp=mat[i][j];
                     mat[i][j]=mat[i][j+1];
                     mat[i][j+1]=temp;
                    }
                }
               
            }else{
                 for(int j=m-1;j>=0;j--){
                    if(j!=0){
                        int temp=mat[i][j];
                        mat[i][j]=mat[i][j-1];
                        mat[i][j-1]=temp;
                    }
                
                }
            }
        }
        }
            for(int i=0;i<mat.size();i++){
            for(int j=0;j<mat[0].size();j++){
               if(mat[i][j]!=nums[i][j])return false;
            }
        }
        return true;
    }
};
